{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/client",
  "functions": {
    "api/server.ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/careers", "destination": "https://yespstudio.com/careers", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/server" }
  ]
}
